package components

import (
	"fmt"
	"kevin-portfolio/internal/agility_cms/types"
)

templ ImageGallery(header string, description string, images []types.ImageGalleryItem) {
	<section class="p-2 font-mono">
		<h1 class="text-3xl lg:text-base text-gray-300 mb-4">{ header }</h1>
		<p class="text-3xl lg:text-base text-gray-500 mb-4">{ description }</p>
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
			for _, image := range images {
				<div>
					<img
						src={ image.URL }
						alt={ getImageAlt(image) }
						class="w-full h-full object-contain"
						loading="lazy"
					/>
				</div>
			}
		</div>
		<p class="text-3xl lg:text-base text-gray-500 mt-4">
			{ formatImageCount(len(images)) } photos 
			<br>
			----------------------------------------
		</p>
	</section>
}

func getImageAlt(image types.ImageGalleryItem) string {
	if image.Label != nil && *image.Label != "" {
		return *image.Label
	}
	return "Travel photograph"
}

func formatImageCount(count int) string {
	if count == 1 {
		return "1"
	}
	return fmt.Sprintf("%d", count)
}
